# Included by one [[domains]] entry via config_file.
# Nested config_file includes are rejected.
host = "admin.example.com"
aliases = ["control.example.com"]
workdir = "/srv/velran/domains/admin.example.com/current"
app = "main.vrn"

[tls]
cert_file = "/run/secrets/velran/admin.example.com-fullchain.pem"
key_file = "/run/secrets/velran/admin.example.com-key.pem"

[storage]
data_root = "data"
max_upload_bytes = 8388608

[static_assets]
root = "public"

[limits]
max_body_bytes = 131072
request_timeout_ms = 8000
max_form_fields = 48
max_form_field_bytes = 4096
max_instructions = 2000000
max_runtime_alloc_bytes = 100663296
max_concurrent_requests = 64
max_queued_requests = 128
queue_timeout_ms = 3000
resource_profiles_file = "config/resource-profiles.toml"

[reload]
enabled = true
poll_interval_ms = 1500
debounce_ms = 300
