# Velran server production configuration sample.
# Copy to /usr/local/etc/velran/server.toml, adapt paths/limits, chmod appropriately,
# then validate with: velran-server --config /usr/local/etc/velran/server.toml --check-config
#
# All filesystem paths in TOML configuration must be absolute.
# Secrets are referenced by *_file; do not put passwords or database URLs here.
# For Host-routed multi-domain deployments see config/server-multidomain.toml.sample.
# `server.app` is the legacy single-domain mode and cannot be combined with [[domains]].

[server]
app = "/srv/velran/current/main.vrn"
listen = "0.0.0.0:443"
insecure_dev_cookies = false
# Pin the deployment to the exact velran-server build. Generate with:
#   velran-server --print-build-id
# expected_build_id = "<64 lowercase hex characters>"

[tls]
cert_file = "/run/secrets/velran/tls-fullchain.pem"
key_file = "/run/secrets/velran/tls-key.pem"
handshake_timeout_ms = 5000
http_redirect_listen = "0.0.0.0:80"
public_host = "www.example.com"

[database]
url_file = "/run/secrets/velran/database-url"
allow_insecure = false

[redis]
url_file = "/run/secrets/velran/redis-url"
allow_insecure = false

[auth]
# Choose LDAP or local auth. Do not configure both as primary identity backends.
# ldap_url = "ldaps://ldap.internal.example"
# ldap_search_base = "ou=people,dc=example,dc=com"
# ldap_username_attribute = "uid"
# ldap_service_bind_dn_file = "/run/secrets/velran/ldap-bind-dn"
# ldap_service_bind_password_file = "/run/secrets/velran/ldap-bind-password"
# totp_secrets_file = "/run/secrets/velran/totp-secrets"
# roles_file = "/usr/local/etc/velran/auth-roles"
# local_auth_db_url_file = "/run/secrets/velran/local-auth-db-url"
require_totp = false
login_max_attempts = 8
login_principal_max_attempts = 16
login_source_max_attempts = 64
mfa_max_attempts = 5
login_window_secs = 300

[web]
# egress_policy_file = "/etc/velran/egress.toml"
trusted_proxy_cidrs = []
allow_missing_origin = false
cors_origins = []
cors_allow_credentials = false

[storage]
data_root = "/srv/velran/data"
fs_mode = "rwc"
max_upload_bytes = 16777216
# Hard ceiling for decoded image dimensions (width * height).
max_image_pixels = 40000000

[static_assets]
root = "/srv/velran/current/public"
url_prefix = "/assets/"
max_asset_bytes = 8388608
max_age_secs = 300
immutable_max_age_secs = 31536000
precompressed = true

[lifecycle]
health_live_path = "/health/live"
health_ready_path = "/health/ready"
health_dependency_timeout_ms = 1000
shutdown_grace_ms = 30000

[observability]
metrics_listen = "127.0.0.1:9090"
allow_public_metrics = false
access_log = true

# Three logical classes: error/system, normal HTTP access, user/security activity audit.
# Log directories must already exist. Files are created in append mode if absent.
# SIGHUP reopens these files after logrotate; it does NOT reload server config.
[logging]
server_file = "/var/log/velran/server.log" # error/system
access_file = "/var/log/velran/access.log" # normal serving
audit_file = "/var/log/velran/audit.log"   # user/security activity
stderr = true

[rate_limit]
policies_file = "/usr/local/etc/velran/rate-limits.toml"
allow_memory = false

[cache]
max_ttl_secs = 3600
max_entries = 10000
max_bytes = 67108864
allow_memory = false

[native]
# Native execution is mandatory; disabling it prevents application activation.
enabled = true
# Security/performance production mode: refuse startup if no native shard can be built and loaded.
required = true
# Optional: omit to discover rustc from RUSTC/PATH.
# rustc = "/usr/bin/rustc"
# Optional: omit to use <app-dir>/.velran-native-cache.
# cache_dir = "/var/cache/velran/native"
optimization = "release"
# Optional explicit rustc target features; use only for a pinned deployment CPU baseline.
# For maximum speed on a host-local cache, let rustc tune for this CPU:
# target_cpu = "native"
# Optional explicit feature override/addition:
# cpu_features = "+sse2,+avx2"

[reload]
mode = "development"
# Shared content-fingerprint watcher for the application source tree.
enabled = true
poll_interval_ms = 1000
debounce_ms = 250
# Development only: print source-located compiler diagnostics to stderr while
# the last valid generation keeps serving requests. Production policy rejects it.
debug_compile_errors = false

[limits]
max_header_bytes = 16384
max_body_bytes = 262144
max_connections = 4096
max_requests_per_connection = 100
read_timeout_ms = 5000
request_timeout_ms = 15000
write_timeout_ms = 5000
max_header_count = 64
max_form_fields = 64
max_form_field_bytes = 8192
max_instructions = 5000000
max_runtime_alloc_bytes = 268435456
session_ttl_secs = 28800
max_sessions = 100000
max_process_memory_bytes = 1073741824
resource_profiles_file = "/usr/local/etc/velran/resource-profiles.toml"

# Optional only when the operator delegates a writable cgroup v2 directory
# directly to velran-server. Do not enable this together with the systemd
# MemoryMax/CPUQuota/TasksMax baseline from examples/systemd/velran.service.
# [cgroup]
# dir = "/sys/fs/cgroup/velran/app"
# memory_max_bytes = 1073741824
# memory_swap_max_bytes = 0
# cpu_percent = 200
# pids_max = 256
