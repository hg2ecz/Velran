# Velran multi-domain application-server mode behind Nginx/Apache.
# TLS, HTTP/2/3 and public Internet connection handling belong to the proxy.

[server]
behind_proxy = true
unix_socket = "/run/velran/velran.sock"
insecure_dev_cookies = false

[limits]
max_connections = 4096
max_body_bytes = 262144
request_timeout_ms = 15000
max_instructions = 5000000
max_runtime_alloc_bytes = 268435456

[cache]
max_ttl_secs = 3600
max_entries = 10000
max_bytes = 67108864
# Maximum time a request waits for another request that is already filling
# the exact same cache key. Only one request generates the missing value.
singleflight_wait_timeout_ms = 5000

[reload]
mode = "development"
# Shared content-fingerprint watcher for the application source tree.
enabled = true
poll_interval_ms = 1000
debounce_ms = 250

[[domains]]
host = "example.com"
aliases = ["www.example.com"]
workdir = "/srv/velran/domains/example.com/current"
app = "main.vrn"

[domains.reload]
# Optional per-domain override of the global reload policy.
enabled = true
poll_interval_ms = 1000
debounce_ms = 250

[domains.limits]
max_concurrent_requests = 64
max_queued_requests = 128
queue_timeout_ms = 3000

[domains.storage]
data_root = "data"

[domains.static_assets]
root = "public"

[[domains]]
host = "shop.example.com"
workdir = "/srv/velran/domains/shop.example.com/current"
app = "main.vrn"

[domains.limits]
max_concurrent_requests = 32
max_queued_requests = 64
queue_timeout_ms = 2000
