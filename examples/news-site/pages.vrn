use crate::commonmark as commonmark;

#[page]
fn article(ctx: PageContext, db: Db, slug: Slug) -> Result<Html, PageError> {
    let article = queries::articleBySlug(db, slug)?;
    let markdown_html = commonmark::render(&article.body);
    return Ok(html {
        @layout(components::Main, article.title) {
            <article>
                <h1>{{ article.title }}</h1>
                {{ markdown_html }}
            </article>
        }
    });
}

route article GET "/cikk/:slug<Slug>" public cache public ttl 60 => pages::article;

#[page]
fn adminArticles(ctx: PageContext) -> Result<Html, PageError> {
    return Ok(html {
        @layout(components::Main, "Articles") {
            <section>
                <h1>Articles</h1>
                <p>The article was saved.</p>
            </section>
        }
    });
}

route adminArticles GET "/admin/articles" auth role Editor => pages::adminArticles;
