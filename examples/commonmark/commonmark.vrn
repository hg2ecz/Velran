// Velran source-level CommonMark renderer.
//
// Markdown syntax policy lives here, in Velran source, not in the engine.
// The engine only provides renderer-neutral SafeHtml construction primitives.
//
// Security profile:
// - raw HTML is never passed through; it is escaped as text;
// - all ordinary text is escaped by safeHtmlText();
// - element names pass through the engine's fixed SafeHtml tag allowlist;
// - links accept only same-origin relative/fragment, https, http and mailto targets;
// - protocol-relative URLs are rejected;
// - line count and recursive blockquote depth are bounded;
// - the application cannot forge SafeHtml from an ordinary String.
//
// This is a security-hardened CommonMark profile. Raw HTML is intentionally
// disabled even though upstream CommonMark permits HTML blocks and inlines.

fn safe_link_target(href: &str) -> bool {
    let value = href.trim();
    let lower = value.to_lowercase();
    if value.starts_with("//") {
        return false;
    }
    if value.starts_with("/") || value.starts_with("./") || value.starts_with("../") || value.starts_with("#") {
        return true;
    }
    return lower.starts_with("https://") || lower.starts_with("http://") || lower.starts_with("mailto:");
}

fn ascii_digit(value: &str) -> bool {
    return value == "0" || value == "1" || value == "2" || value == "3" || value == "4" || value == "5" || value == "6" || value == "7" || value == "8" || value == "9";
}

fn ascii_punctuation(value: &str) -> bool {
    return value == "!" || value == "\"" || value == "#" || value == "$" || value == "%" || value == "&" || value == "'" || value == "(" || value == ")" || value == "*" || value == "+" || value == "," || value == "-" || value == "." || value == "/" || value == ":" || value == ";" || value == "<" || value == "=" || value == ">" || value == "?" || value == "@" || value == "[" || value == "\\" || value == "]" || value == "^" || value == "_" || value == "`" || value == "{" || value == "|" || value == "}" || value == "~";
}

fn whitespace(value: &str) -> bool {
    return value == " " || value == "\t" || value == "\n" || value == "\r";
}

fn run_length(text: &str, start: i64, marker: &str) -> i64 {
    let mut i = start;
    let n = text.chars().count();
    while i < n && charAt(text, i) == marker {
        i += 1;
    }
    return i - start;
}

fn same_marker_line(line: &str, marker: &str, min_count: i64) -> bool {
    let prefix_spaces = leading_spaces(line);
    if prefix_spaces > 3 {
        return false;
    }
    let compact = line.trim().replace(" ", "").replace("\t", "");
    let n = compact.chars().count();
    if n < min_count {
        return false;
    }
    let mut i = 0;
    while i < n {
        if charAt(compact, i) != marker {
            return false;
        }
        i += 1;
    }
    return true;
}

fn thematic_break(line: &str) -> bool {
    let dash = same_marker_line(line, "-", 3);
    let star = same_marker_line(line, "*", 3);
    let underscore = same_marker_line(line, "_", 3);
    return dash || star || underscore;
}

fn setext_level(line: &str) -> i64 {
    let equals = same_marker_line(line, "=", 1);
    if equals {
        return 1;
    }
    let dash = same_marker_line(line, "-", 1);
    if dash {
        return 2;
    }
    return 0;
}

fn leading_spaces(line: &str) -> i64 {
    let n = line.chars().count();
    let mut i = 0;
    while i < n && charAt(line, i) == " " {
        i += 1;
    }
    return i;
}

fn strip_up_to_three_spaces(line: &str) -> String {
    let spaces = leading_spaces(line);
    if spaces == 0 {
        return line.to_string();
    }
    if spaces > 3 {
        return line.to_string();
    }
    return substring(line, spaces);
}

fn ordered_content_offset(line: &str) -> i64 {
    let n = line.chars().count();
    if n < 2 {
        return -1;
    }
    let mut i = 0;
    let mut scanning_digits = true;
    while i < n && i < 9 && scanning_digits {
        let digit_char = charAt(line, i);
        let is_digit = ascii_digit(&digit_char);
        if is_digit {
            i += 1;
        } else {
            scanning_digits = false;
        }
    }
    if i == 0 || i >= n {
        return -1;
    }
    let marker = charAt(line, i);
    if marker != "." && marker != ")" {
        return -1;
    }
    let mut j = i + 1;
    let mut spaces = 0;
    while j < n && spaces < 4 && (charAt(line, j) == " " || charAt(line, j) == "\t") {
        spaces += 1;
        j += 1;
    }
    if spaces == 0 {
        return -1;
    }
    return j;
}

fn ordered_delimiter(line: &str) -> String {
    let n = line.chars().count();
    let mut i = 0;
    let mut scanning_digits = true;
    while i < n && i < 9 && scanning_digits {
        let digit_char = charAt(line, i);
        let is_digit = ascii_digit(&digit_char);
        if is_digit {
            i += 1;
        } else {
            scanning_digits = false;
        }
    }
    if i < n {
        return charAt(line, i);
    }
    return "".to_string();
}

fn unordered_content_offset(line: &str) -> i64 {
    let n = line.chars().count();
    if n < 2 {
        return -1;
    }
    let marker = charAt(line, 0);
    if marker != "-" && marker != "+" && marker != "*" {
        return -1;
    }
    let mut i = 1;
    let mut spaces = 0;
    while i < n && spaces < 4 && (charAt(line, i) == " " || charAt(line, i) == "\t") {
        spaces += 1;
        i += 1;
    }
    if spaces == 0 {
        return -1;
    }
    return i;
}

fn strip_atx_closing_hashes(text: &str) -> String {
    let mut value = text.trim().to_string();
    let mut n = value.chars().count();
    while n > 0 && charAt(value, n - 1) == "#" {
        n -= 1;
    }
    if n < value.chars().count() {
        let mut closing_hashes_valid = n == 0;
        if n > 0 {
            let before_hashes = charAt(value, n - 1);
            closing_hashes_valid = whitespace(&before_hashes);
        }
        if closing_hashes_valid {
            value = substring(value, 0, n).trim_end();
        }
    }
    return value;
}

fn atx_level(line: &str) -> i64 {
    let value = strip_up_to_three_spaces(line);
    let n = value.chars().count();
    let mut i = 0;
    while i < n && i < 7 && charAt(value, i) == "#" {
        i += 1;
    }
    if i == 0 || i > 6 {
        return 0;
    }
    if i == n {
        return i;
    }
    let after_hashes = charAt(value, i);
    let has_separator = whitespace(&after_hashes);
    if has_separator {
        return i;
    }
    return 0;
}

fn atx_content(line: &str, level: i64) -> String {
    let value = strip_up_to_three_spaces(line);
    if level >= value.chars().count() {
        return "".to_string();
    }
    let body = substring(value, level).trim_start();
    return strip_atx_closing_hashes(&body);
}

fn fence_run(line: &str) -> i64 {
    let value = strip_up_to_three_spaces(line);
    let n = value.chars().count();
    if n < 3 {
        return 0;
    }
    let marker = charAt(value, 0);
    if marker != "`" && marker != "~" {
        return 0;
    }
    let count = run_length(&value, 0, &marker);
    if count < 3 {
        return 0;
    }
    return count;
}

fn closing_fence(line: &str, marker: &str, opening_len: i64) -> bool {
    let value = strip_up_to_three_spaces(line);
    if !value.starts_with(marker) {
        return false;
    }
    let count = run_length(&value, 0, marker);
    if count < opening_len {
        return false;
    }
    if count == value.chars().count() {
        return true;
    }
    return substring(value, count).trim().chars().count() == 0;
}

fn normalize_code_span(text: &str) -> String {
    let mut value = text.replace("\n", " ").replace("\r", " ");
    if value.starts_with(" ") && value.ends_with(" ") && value.trim().chars().count() > 0 {
        value = substring(value, 1, value.chars().count() - 2);
    }
    return value;
}

fn render_inline(input: &str) -> SafeHtml {
    let mut out = safeHtmlEmpty();
    let mut i = 0;
    let n = input.chars().count();

    while i < n {
        let rest = substring(input, i);
        let mut handled = false;

        // CommonMark hard/soft line breaks inside paragraph text.
        if rest.starts_with("  \n") {
            out = safeHtmlConcat(out, safeHtmlElement("br", safeHtmlEmpty()));
            i += 3;
            handled = true;
        }
        if !handled && rest.starts_with("\\\n") {
            out = safeHtmlConcat(out, safeHtmlElement("br", safeHtmlEmpty()));
            i += 2;
            handled = true;
        }
        if !handled && rest.starts_with("\n") {
            out = safeHtmlConcat(out, safeHtmlText(" "));
            i += 1;
            handled = true;
        }

        // Backslash escaping applies only to ASCII punctuation.
        if !handled && rest.starts_with("\\") && i + 1 < n {
            let next = charAt(input, i + 1);
            let escaped_punctuation = ascii_punctuation(&next);
            if escaped_punctuation {
                out = safeHtmlConcat(out, safeHtmlText(next));
                i += 2;
                handled = true;
            }
        }

        // Arbitrary-length backtick code spans.
        if !handled && rest.starts_with("`") {
            let ticks = run_length(input, i, "`");
            let mut j = i + ticks;
            let mut close = -1;
            while j < n && close < 0 {
                if charAt(input, j) == "`" {
                    let candidate = run_length(input, j, "`");
                    if candidate == ticks {
                        close = j;
                    }
                    if close < 0 {
                        j += candidate;
                    }
                }
                if close < 0 && j < n && charAt(input, j) != "`" {
                    j += 1;
                }
            }
            if close >= 0 {
                let content = substring(input, i + ticks, close - i - ticks);
                let normalized_code = normalize_code_span(&content);
                out = safeHtmlConcat(out, safeHtmlElement("code", safeHtmlText(normalized_code)));
                i = close + ticks;
                handled = true;
            }
        }

        // Inline links. Destination parsing accepts balanced parentheses and
        // applies the generic engine URL policy before producing SafeHtml.
        if !handled && rest.starts_with("[") {
            let close_label = indexOf(rest, "](");
            if close_label > 0 {
                let mut j = i + close_label + 2;
                let mut depth = 0;
                let mut close_url = -1;
                while j < n && close_url < 0 {
                    let ch = charAt(input, j);
                    if ch == "(" {
                        depth += 1;
                    }
                    if ch == ")" {
                        if depth == 0 {
                            close_url = j;
                        } else {
                            depth -= 1;
                        }
                    }
                    j += 1;
                }
                if close_url >= 0 {
                    let label = substring(input, i + 1, close_label - 1);
                    let href = substring(input, i + close_label + 2, close_url - i - close_label - 2).trim();
                    let safe_href = safe_link_target(&href);
                    if safe_href {
                        let rendered_label = render_inline(&label);
                        out = safeHtmlConcat(out, safeHtmlLink(href, rendered_label));
                        i = close_url + 1;
                        handled = true;
                    }
                }
            }
        }

        // URI and email autolinks. Raw HTML-like angle-bracket forms are not
        // passed through and therefore fall through to escaped text.
        if !handled && rest.starts_with("<") {
            let close = indexOf(rest, ">");
            if close > 1 {
                let target = substring(rest, 1, close - 1);
                let safe_target = safe_link_target(&target);
                if safe_target {
                    out = safeHtmlConcat(out, safeHtmlLink(target, safeHtmlText(target)));
                    i += close + 1;
                    handled = true;
                } else if target.contains("@") && !target.contains(" ") && !target.contains("\t") {
                    let mailto = "mailto:" + target;
                    out = safeHtmlConcat(out, safeHtmlLink(mailto, safeHtmlText(target)));
                    i += close + 1;
                    handled = true;
                }
            }
        }

        // Strong emphasis. Delimiter content is parsed recursively so nested
        // code/link/emphasis remains safe and composable.
        if !handled && (rest.starts_with("**") || rest.starts_with("__")) {
            let delimiter = substring(rest, 0, 2);
            let tail = substring(rest, 2);
            let close = indexOf(tail, &delimiter);
            if close > 0 {
                let content = substring(&tail, 0, close);
                let rendered_content = render_inline(&content);
                out = safeHtmlConcat(out, safeHtmlElement("strong", rendered_content));
                i += close + 4;
                handled = true;
            }
        }

        // Emphasis. Underscore delimiters are not interpreted inside an
        // alphanumeric word, matching the important CommonMark intraword rule.
        if !handled && (rest.starts_with("*") || rest.starts_with("_")) {
            let delimiter = charAt(input, i);
            let mut previous = " ".to_string();
            let mut next = " ".to_string();
            if i > 0 {
                previous = charAt(input, i - 1);
            }
            if i + 1 < n {
                next = charAt(input, i + 1);
            }
            let previous_space = whitespace(&previous);
            let previous_punctuation = ascii_punctuation(&previous);
            let next_space = whitespace(&next);
            let next_punctuation = ascii_punctuation(&next);
            let underscore_word = delimiter == "_" && !previous_space && !previous_punctuation && !next_space && !next_punctuation;
            if !underscore_word {
                let tail = substring(input, i + 1);
                let close = indexOf(tail, &delimiter);
                if close > 0 {
                    let content = substring(&tail, 0, close);
                    let rendered_content = render_inline(&content);
                    out = safeHtmlConcat(out, safeHtmlElement("em", rendered_content));
                    i += close + 2;
                    handled = true;
                }
            }
        }

        if !handled {
            out = safeHtmlConcat(out, safeHtmlText(charAt(input, i)));
            i += 1;
        }
    }

    return out;
}

fn render_blocks(source: &str, depth: i64) -> SafeHtml {
    if depth > 8 {
        return safeHtmlElement("p", safeHtmlText(source));
    }

    let normalized = source.replace("\r\n", "\n").replace("\r", "\n");
    let lines = splitBounded(normalized, "\n", 2048);
    let mut out = safeHtmlEmpty();
    let mut paragraph = "".to_string();
    let mut in_paragraph = false;
    let mut list_body = safeHtmlEmpty();
    let mut list_kind = "".to_string();
    let mut list_marker = "".to_string();
    let mut in_list = false;
    let mut in_code = false;
    let mut code_marker = "".to_string();
    let mut code_fence_len = 0;
    let mut code_text = "".to_string();
    let mut quote_text = "".to_string();
    let mut in_quote = false;
    let mut i = 0;

    while i < lines.len() {
        let line = lines[i];
        let block_line = strip_up_to_three_spaces(&line);
        let trimmed = block_line.trim();
        let mut handled = false;

        // Continue or close a fenced code block. A closing fence must use the
        // same marker and be at least as long as the opening fence.
        if in_code {
            let closes_code_fence = closing_fence(&line, &code_marker, code_fence_len);
            if closes_code_fence {
                let code = safeHtmlElement("code", safeHtmlText(code_text));
                out = safeHtmlConcat(out, safeHtmlElement("pre", code));
                code_text = "".to_string();
                code_marker = "".to_string();
                code_fence_len = 0;
                in_code = false;
            } else {
                code_text = code_text + line + "\n";
            }
            handled = true;
        }

        // Consecutive blockquote lines are accumulated and parsed recursively
        // as a bounded nested block container.
        if !handled && in_quote && !block_line.starts_with(">") {
            let rendered_quote = render_blocks(&quote_text, depth + 1);
            out = safeHtmlConcat(out, safeHtmlElement("blockquote", rendered_quote));
            quote_text = "".to_string();
            in_quote = false;
        }
        if !handled && block_line.starts_with(">") {
            if in_paragraph {
                let rendered_paragraph = render_inline(&paragraph);
                out = safeHtmlConcat(out, safeHtmlElement("p", rendered_paragraph));
                paragraph = "".to_string();
                in_paragraph = false;
            }
            if in_list {
                out = safeHtmlConcat(out, safeHtmlElement(list_kind, list_body));
                list_body = safeHtmlEmpty();
                list_kind = "".to_string();
                list_marker = "".to_string();
                in_list = false;
            }
            let mut body = substring(block_line, 1);
            if body.starts_with(" ") || body.starts_with("\t") {
                body = substring(&body, 1);
            }
            if in_quote {
                quote_text = quote_text + "\n" + body;
            } else {
                quote_text = body;
                in_quote = true;
            }
            handled = true;
        }

        // Opening fenced code block. Backtick info strings containing a
        // backtick are rejected as ordinary paragraph text.
        if !handled {
            let fence_len = fence_run(&line);
            if fence_len >= 3 {
                let candidate = strip_up_to_three_spaces(&line);
                let marker = charAt(&candidate, 0);
                let info = substring(candidate, fence_len).trim();
                let valid_info = marker != "`" || !info.contains("`");
                if valid_info {
                    if in_paragraph {
                        let rendered_paragraph = render_inline(&paragraph);
                        out = safeHtmlConcat(out, safeHtmlElement("p", rendered_paragraph));
                        paragraph = "".to_string();
                        in_paragraph = false;
                    }
                    if in_list {
                        out = safeHtmlConcat(out, safeHtmlElement(list_kind, list_body));
                        list_body = safeHtmlEmpty();
                        list_kind = "".to_string();
                        list_marker = "".to_string();
                        in_list = false;
                    }
                    in_code = true;
                    code_marker = marker;
                    code_fence_len = fence_len;
                    handled = true;
                }
            }
        }

        // Four-space indented code blocks. Consecutive indented lines are
        // emitted as one pre/code block; blank lines inside are preserved.
        let line_leading_spaces = leading_spaces(&line);
        if !handled && line_leading_spaces >= 4 {
            if in_paragraph {
                paragraph = paragraph + "\n" + line.trim();
                handled = true;
            } else {
                let mut indented = "".to_string();
                let mut j = i;
                let mut collecting_indented = true;
                while j < lines.len() && collecting_indented {
                    let candidate_line = lines[j];
                    let candidate_spaces = leading_spaces(&candidate_line);
                    let candidate_blank = candidate_line.trim().chars().count() == 0;
                    if candidate_spaces >= 4 {
                        indented = indented + substring(&candidate_line, 4) + "\n";
                        j += 1;
                    } else if candidate_blank {
                        indented = indented + "\n";
                        j += 1;
                    } else {
                        collecting_indented = false;
                    }
                }
                out = safeHtmlConcat(out, safeHtmlElement("pre", safeHtmlElement("code", safeHtmlText(indented))));
                i = j - 1;
                handled = true;
            }
        }

        // Blank line closes a paragraph. Lists are also closed; this profile
        // intentionally does not preserve loose-list paragraph wrappers.
        if !handled && trimmed.chars().count() == 0 {
            if in_paragraph {
                let rendered_paragraph = render_inline(&paragraph);
                out = safeHtmlConcat(out, safeHtmlElement("p", rendered_paragraph));
                paragraph = "".to_string();
                in_paragraph = false;
            }
            if in_list {
                out = safeHtmlConcat(out, safeHtmlElement(list_kind, list_body));
                list_body = safeHtmlEmpty();
                list_kind = "".to_string();
                list_marker = "".to_string();
                in_list = false;
            }
            handled = true;
        }

        // Setext headings use the immediately preceding paragraph and accept
        // any non-empty run of '=' or '-'.
        if !handled && in_paragraph {
            let level = setext_level(&block_line);
            if level > 0 {
                let mut tag = "h2".to_string();
                if level == 1 {
                    tag = "h1".to_string();
                }
                let rendered_paragraph = render_inline(&paragraph);
                out = safeHtmlConcat(out, safeHtmlElement(tag, rendered_paragraph));
                paragraph = "".to_string();
                in_paragraph = false;
                handled = true;
            }
        }

        // Thematic breaks are recognized before list markers.
        let is_thematic_break = thematic_break(&block_line);
        if !handled && is_thematic_break {
            if in_paragraph {
                let rendered_paragraph = render_inline(&paragraph);
                out = safeHtmlConcat(out, safeHtmlElement("p", rendered_paragraph));
                paragraph = "".to_string();
                in_paragraph = false;
            }
            if in_list {
                out = safeHtmlConcat(out, safeHtmlElement(list_kind, list_body));
                list_body = safeHtmlEmpty();
                list_kind = "".to_string();
                list_marker = "".to_string();
                in_list = false;
            }
            out = safeHtmlConcat(out, safeHtmlElement("hr", safeHtmlEmpty()));
            handled = true;
        }

        // ATX headings: one to six hashes, optional closing hash sequence, and
        // up to three leading spaces.
        if !handled {
            let level = atx_level(&line);
            if level > 0 {
                if in_paragraph {
                    let rendered_paragraph = render_inline(&paragraph);
                    out = safeHtmlConcat(out, safeHtmlElement("p", rendered_paragraph));
                    paragraph = "".to_string();
                    in_paragraph = false;
                }
                if in_list {
                    out = safeHtmlConcat(out, safeHtmlElement(list_kind, list_body));
                    list_body = safeHtmlEmpty();
                    list_kind = "".to_string();
                    list_marker = "".to_string();
                    in_list = false;
                }
                let mut tag = "h1".to_string();
                if level == 2 { tag = "h2".to_string(); }
                if level == 3 { tag = "h3".to_string(); }
                if level == 4 { tag = "h4".to_string(); }
                if level == 5 { tag = "h5".to_string(); }
                if level == 6 { tag = "h6".to_string(); }
                let heading_text = atx_content(&line, level);
                let rendered_heading = render_inline(&heading_text);
                out = safeHtmlConcat(out, safeHtmlElement(tag, rendered_heading));
                handled = true;
            }
        }

        // Unordered list items. A marker change starts a new list, matching
        // CommonMark's list marker grouping rule.
        if !handled {
            let offset = unordered_content_offset(&block_line);
            if offset >= 0 {
                let marker = charAt(&block_line, 0);
                if in_paragraph {
                    let rendered_paragraph = render_inline(&paragraph);
                    out = safeHtmlConcat(out, safeHtmlElement("p", rendered_paragraph));
                    paragraph = "".to_string();
                    in_paragraph = false;
                }
                if in_list && (list_kind != "ul" || list_marker != marker) {
                    out = safeHtmlConcat(out, safeHtmlElement(list_kind, list_body));
                    list_body = safeHtmlEmpty();
                    in_list = false;
                }
                if !in_list {
                    in_list = true;
                    list_kind = "ul".to_string();
                    list_marker = marker;
                }
                let item_text = substring(block_line, offset);
                let rendered_item = render_inline(&item_text);
                list_body = safeHtmlConcat(list_body, safeHtmlElement("li", rendered_item));
                handled = true;
            }
        }

        // Ordered list items. '.' and ')' delimiters form distinct lists.
        if !handled {
            let offset = ordered_content_offset(&block_line);
            if offset >= 0 {
                let delimiter = ordered_delimiter(&block_line);
                if in_paragraph {
                    let rendered_paragraph = render_inline(&paragraph);
                    out = safeHtmlConcat(out, safeHtmlElement("p", rendered_paragraph));
                    paragraph = "".to_string();
                    in_paragraph = false;
                }
                if in_list && (list_kind != "ol" || list_marker != delimiter) {
                    out = safeHtmlConcat(out, safeHtmlElement(list_kind, list_body));
                    list_body = safeHtmlEmpty();
                    in_list = false;
                }
                if !in_list {
                    in_list = true;
                    list_kind = "ol".to_string();
                    list_marker = delimiter;
                }
                let item_text = substring(block_line, offset);
                let rendered_item = render_inline(&item_text);
                list_body = safeHtmlConcat(list_body, safeHtmlElement("li", rendered_item));
                handled = true;
            }
        }

        // A non-list block closes a pending list before paragraph accumulation.
        if !handled && in_list {
            out = safeHtmlConcat(out, safeHtmlElement(list_kind, list_body));
            list_body = safeHtmlEmpty();
            list_kind = "".to_string();
            list_marker = "".to_string();
            in_list = false;
        }

        // Consecutive ordinary lines form one paragraph. Newlines are kept so
        // render_inline can distinguish soft breaks from explicit hard breaks.
        if !handled {
            if in_paragraph {
                paragraph = paragraph + "\n" + block_line;
            } else {
                paragraph = block_line;
                in_paragraph = true;
            }
        }

        i += 1;
    }

    if in_quote {
        let rendered_quote = render_blocks(&quote_text, depth + 1);
        out = safeHtmlConcat(out, safeHtmlElement("blockquote", rendered_quote));
    }
    if in_code {
        out = safeHtmlConcat(out, safeHtmlElement("pre", safeHtmlElement("code", safeHtmlText(code_text))));
    }
    if in_list {
        out = safeHtmlConcat(out, safeHtmlElement(list_kind, list_body));
    }
    if in_paragraph {
        let rendered_paragraph = render_inline(&paragraph);
        out = safeHtmlConcat(out, safeHtmlElement("p", rendered_paragraph));
    }

    return out;
}

pub fn render(source: &str) -> SafeHtml {
    return render_blocks(source, 0);
}
